# Auto detect text files and perform LF normalization
* text=auto eol=lf

# PowerShell scripts must use CRLF on Windows for compatibility
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Markdown, JSON, YAML use standard LF
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
